{
  "name": "infraestructura-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tests E2E del stack completo (Nginx + Frontend + Backend). Este repo no tiene codigo de aplicacion: solo configuracion de infraestructura y estos tests.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=20"
  }
}
